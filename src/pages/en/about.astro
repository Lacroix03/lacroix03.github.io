---
import { getEntry, render } from "astro:content";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about-en");

if (!aboutPost) {
	throw new Error("English about page content not found");
}

const { Content } = await render(aboutPost);
---

<MainGridLayout title="About" description="About lacroix03" lang="en">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<LanguageSwitcher
				links={[
					{ label: "한국어", href: "/about/" },
					{ label: "English", href: "/en/about/", current: true },
				]}
			/>
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
